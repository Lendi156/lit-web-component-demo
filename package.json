{
  "name": "monorepo-ui",
  "version": "1.0.0",
  "description": "This repo use for runing multiple repo with different js framework",
  "workspaces": [
    "cyberpunk-ui",
    "react-dashboard",
    "vue-dashboard",
    "angular-dashboard",
    "storybook",
    "example"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "clean:cyberpunk-ui": "npm run clean --workspace=@edts/cyberpunk-ui",
    "clean:react-dashboard": "npm run clean --workspace=react-dashboard",
    "clean:storybook": "npm run clean --workspace=ui-storybook",
    "clean:vue-dashboard": "npm run clean --workspace=vue-dashboard",
    "clean:angular-dashboard": "npm run clean --workspace=angular-dashboard",
    "clean:example": "npm run clean --workspace=example",
    "clean:core": "rm -rf node_modules",
    "clean": "npm run clean:cyberpunk-ui && npm run clean:react-dashboard && clean:vue-dashboard && npm run clean:example",
    "install:cyberpunk-ui": "npm install --workspace=@edts/cyberpunk-ui",
    "install:react-dashboard": "npm install --workspace=react-dashboard",
    "install:storybook": "npm install --workspace=ui-storybook",
    "install:vue-dashboard": "npm install --workspace=vue-dashboard",
    "install:angular-dashboard": "npm install --workspace=angular-dashboard",
    "intall:example": "npm install --workspace=example",
    "install:all": "npm run install:cyberpunk-ui && npm run install:react-dashboard && npm run install:vue-dashboard && npm run install:angular-dashboard && npm run install:example",
    "dev:cyberpunk-ui": "npm run dev --workspace=cyberpunk-ui",
    "dev:react-dashboard": "npm run dev --workspace=react-dashboard",
    "dev:storybook": "npm run dev --workspace=ui-storybook",
    "build:storybook": "npm run build --workspace=ui-storybook",
    "dev:vue-dashboard": "npm run dev --workspace=vue-dashboard",
    "dev:angular-dashboard": "npm run start --workspace=angular-dashboard",
    "dev:example": "npm run dev --workspace=example",
    "build:cyberpunk-ui": "npm run build --workspace=@edts/cyberpunk-ui",
    "build:react-dashboard": "npm run build --workspace=react-dashboard",
    "build:vue-dashboard": "npm run build --workspace=vue-dashboard",
    "build:angular-dashboard": "npm run build --workspace=angular-dashboard"
  },
  "author": "",
  "license": "ISC"
}